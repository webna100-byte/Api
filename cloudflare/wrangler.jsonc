{
  // Cloudflare Workers Free plan: no card needed. Durable
  // Objects (SQLite-backed) and alarms are all included in the free tier.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "video-ui",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The UI (../public) is bundled into the Worker by build-assets.mjs.
  "build": { "command": "node build-assets.mjs" },
  "durable_objects": {
    "bindings": [{ "name": "QUEUE", "class_name": "QueueDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueDO"] }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (API keys, ACCESS_TOKEN) are set with
  // `wrangler secret put NAME` or in the dashboard, never here.
  "vars": {
    "MAX_GENERATIONS_TOTAL": "20",
    "POLL_INTERVAL_MS": "5000",
    "TASK_TIMEOUT_MS": "1200000",
    "GENERATE_AUDIO": "true"
  }
}
