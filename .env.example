# Copy to .env (server-side only; never committed, never sent to the browser).

PORT=3000
HOST=127.0.0.1

# ---- Safety caps (protect free credit) ---------------------------------
# Max total submissions across all providers. Counted when a task is accepted.
MAX_GENERATIONS_TOTAL=20
# Optional per-provider caps:
# WAVESPEED_MAX_GENERATIONS=3
# ATLAS_MAX_GENERATIONS=3

POLL_INTERVAL_MS=5000
TASK_TIMEOUT_MS=1200000
GENERATE_AUDIO=true

# ---- WaveSpeedAI ---------------------------------------------------------
WAVESPEED_API_KEY=
# WAVESPEED_MODEL=bytedance/seedance-2.0/reference-to-video   # used when images are attached
# WAVESPEED_MODEL_TEXT=bytedance/seedance-2.0/text-to-video   # text only

# ---- Atlas Cloud ---------------------------------------------------------
ATLAS_API_KEY=
# ATLAS_MODEL=bytedance/seedance-2.0/text-to-video
# ATLAS_MODEL_REF=bytedance/seedance-2.0/reference-to-video   # UNVERIFIED id, check playground

# ---- Mock provider (local ffmpeg test pattern, free, no key) --------------
MOCK_ENABLED=true
MOCK_DELAY_MS=3000
# Simulate "out of credit" after N submissions to test that the queue stops:
MOCK_CREDIT_FAIL_AFTER=0
